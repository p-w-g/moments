PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Editor-role token (read+write) — needed only for /dev/heroes (draft hero
# candidates). Named "editor", not "read", on purpose: this token can write,
# and treating it as read-only is how you end up surprised by an accidental
# mutation. Create at sanity.io/manage → API → Tokens. Never committed.
SANITY_API_EDITOR_TOKEN=
